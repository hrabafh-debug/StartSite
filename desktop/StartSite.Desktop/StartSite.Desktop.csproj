<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Jen Windows: StartSite spravuje procesy na tomhle počítači -->
		<TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>WinExe</OutputType>
		<RootNamespace>StartSite.Desktop</RootNamespace>
		<AssemblyName>StartSite</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>StartSite</ApplicationTitle>
		<ApplicationId>cz.startsite.desktop</ApplicationId>
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Bez MSIX balíčku, StartSite.exe jde spustit přímo ze složky -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

		<!-- Vlastní Main v Platforms/Windows/Program.cs: Velopack musí běžet jako první -->
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<!-- Verzi při vydání přepisuje skript release.ps1 (-p:Version=...) -->
		<Version>0.2.0</Version>

		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#18181B" />
		<MauiFont Include="Resources\Fonts\*.ttf" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Velopack" Version="1.2.161" />
	</ItemGroup>

</Project>
